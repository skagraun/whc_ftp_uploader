# Ez a fájl csak SABLON. Minden telephelyen/szerveren (BG) másold
# .env néven a deploy-package mappa gyökerébe (server.js mellé), és
# töltsd ki a valós, helyi értékekkel. A .env SOHA nem kerül git-be
# és a deploy csomagba sem (lásd .gitignore, scripts/deploy-package.sh).

# A figyelt helyi mappa (innen olvassuk ki a .txt fájlokat) - abszolút
# útvonal a legbiztosabb.
WATCH_DIR="C:\path\to\watched\folder"
# Sikeresen feltöltött fájlok ide kerülnek át (WATCH_DIR alá).
UPLOADED_SUBDIR=uploaded
# Ha üres/hiányzik, a log a WATCH_DIR\LOG mappába íródik naponta.
# LOG_DIR=C:\ProgramData\WHC_FTP_Logs
# Ennyi napnál régebbi log fájlokat töröl automatikusan minden
# futáskor. 0 vagy negatív érték = nincs automatikus törlés.
# (FONTOS: ez csak a logokra vonatkozik, a feltöltött fájlokra nem.)
LOG_RETENTION_DAYS=90

# FTP (FTPS, implicit TLS) kapcsolat adatai - telephelyenként/BG-nként eltérhetnek.
FTP_HOST=ftp.example.com
FTP_PORT=990
FTP_USER=changeme
FTP_PASSWORD=changeme
FTP_REMOTE_DIR=/ # a távoli mappa, ahova a fájlok kerülnek

# Ütemezés cron szintaxissal (alapból óránként, a 0. percben).
CRON_EXPRESSION=0 * * * *

# A webes felület "Futtatás most" gombjához szükséges megosztott
# titkos kód (shared secret). Üresen hagyva a védelem ki van kapcsolva
# (nem ajánlott, mivel bárki elindíthatná a feltöltést, aki eléri a szervert).
RUN_UPLOAD_TOKEN=changeme
